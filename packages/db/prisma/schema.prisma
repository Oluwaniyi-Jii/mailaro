generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  gmailConnection GmailConnection?
  trackedEmails TrackedEmail[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Separate from NextAuth's Account to handle specific Gmail permissions securely
model GmailConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  emailAddress String
  refreshToken String?  @db.Text
  accessToken  String?  @db.Text
  expiresAt    Int?
  scope        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackedEmails TrackedEmail[]
}

enum TrackingEventType {
  open
  click
}

enum TrackingState {
  tracked
  untracked
  disabled
}

model TrackedEmail {
  id                String        @id @default(cuid())
  userId            String
  gmailConnectionId String
  subject           String?
  gmailMessageId    String
  gmailThreadId     String?
  senderEmail       String
  sentAt            DateTime
  trackingState     TrackingState @default(tracked)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  gmailConnection   GmailConnection   @relation(fields: [gmailConnectionId], references: [id], onDelete: Cascade)
  recipients        TrackedRecipient[]
  links             TrackedLink[]
  events            TrackingEvent[]

  @@unique([gmailConnectionId, gmailMessageId])
  @@index([userId, sentAt])
}

model TrackedRecipient {
  id             String   @id @default(cuid())
  trackedEmailId String
  emailAddress   String
  displayName    String?
  tokenHash      String   @unique
  createdAt      DateTime @default(now())

  trackedEmail   TrackedEmail    @relation(fields: [trackedEmailId], references: [id], onDelete: Cascade)
  links          TrackedLink[]
  events         TrackingEvent[]

  @@index([trackedEmailId, emailAddress])
}

model TrackedLink {
  id                 String   @id @default(cuid())
  trackedEmailId     String
  trackedRecipientId String
  originalUrl        String   @db.Text
  label              String?
  position           Int
  tokenHash          String   @unique
  createdAt          DateTime @default(now())

  trackedEmail       TrackedEmail     @relation(fields: [trackedEmailId], references: [id], onDelete: Cascade)
  trackedRecipient   TrackedRecipient @relation(fields: [trackedRecipientId], references: [id], onDelete: Cascade)
  events             TrackingEvent[]

  @@index([trackedEmailId, position])
  @@index([trackedRecipientId])
}

model TrackingEvent {
  id                 String            @id @default(cuid())
  eventId            String            @unique
  type               TrackingEventType
  trackedEmailId     String
  trackedRecipientId String
  trackedLinkId      String?
  occurredAt         DateTime          @default(now())
  userAgent          String?           @db.Text
  source             String?
  createdAt          DateTime          @default(now())

  trackedEmail       TrackedEmail     @relation(fields: [trackedEmailId], references: [id], onDelete: Cascade)
  trackedRecipient   TrackedRecipient @relation(fields: [trackedRecipientId], references: [id], onDelete: Cascade)
  trackedLink        TrackedLink?     @relation(fields: [trackedLinkId], references: [id], onDelete: SetNull)

  @@index([trackedEmailId, occurredAt])
  @@index([trackedRecipientId, occurredAt])
  @@index([type, occurredAt])
}
